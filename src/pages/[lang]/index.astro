---
import ToolCard from '../../components/ToolCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categoryLabels, locales, siteName, ui } from '../../data/site';
import { getHomeAudienceList, getHomeTrustBlocks } from '../../lib/page-content';
import { converters } from '../../data/converters';
import { getHomeMetaDescription, getHomePageTitle } from '../../lib/home-seo';
import { getHomepageHighlightTools, getPriorityHubLinks } from '../../lib/site-navigation';
import type { ConverterCategory, Locale } from '../../types';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const labels = ui[locale];
const priorityHubs = getPriorityHubLinks(locale);
const categories = priorityHubs.map((item) => item.category) as ConverterCategory[];
const homepageHighlights = getHomepageHighlightTools(6);
const title = getHomePageTitle(locale);
const description = getHomeMetaDescription(locale);
const trustBlocks = getHomeTrustBlocks(locale);
const audienceList = getHomeAudienceList(locale);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteName[locale],
    url: `https://online-converter.evyatarhazan.com/${locale}/`,
    potentialAction: {
      '@type': 'SearchAction',
      target: `https://online-converter.evyatarhazan.com/${locale}/?q={search_term_string}`,
      'query-input': 'required name=search_term_string'
    }
  }
];
const copy = {
  popularEyebrow: locale === 'he' ? 'פופולרי עכשיו' : 'Popular now',
  popularTitle: locale === 'he' ? 'ממירים פופולריים שכדאי להתחיל מהם' : 'Popular converters worth opening first',
  popularDescription:
    locale === 'he'
      ? 'הכלים האלה כבר מסומנים כעדיפות גבוהה, ולכן הם גם נקודת כניסה טובה למשתמשים חדשים וגם hub חזק לקישורים פנימיים.'
      : 'These tools are already marked as high-priority pages, so they work well as starting points for new users and as stronger internal linking hubs.',
  newEyebrow: locale === 'he' ? 'חדש באתר' : 'New on the site',
  newTitle: locale === 'he' ? 'כלים חדשים שיכולים למשוך עוד חיפושים' : 'New converters that can win more search demand',
  newDescription:
    locale === 'he'
      ? 'הכלים החדשים עוזרים להרחיב כיסוי חיפושים ולחבר משתמשים לעמודים שעוד צריכים לצבור authority.'
      : 'Fresh tools expand search coverage and help route users toward pages that still need to build authority.',
  trustEyebrow: locale === 'he' ? 'איך האתר בנוי לעבודה אמיתית' : 'How the site is built for real work',
  trustTitle: locale === 'he' ? 'מה מקבלים מעבר להמרה עצמה' : 'What you get beyond the conversion itself',
  audienceEyebrow: locale === 'he' ? 'למי זה מתאים' : 'Who this helps',
  audienceTitle: locale === 'he' ? 'צוותים ומשימות שהאתר הזה מכסה טוב' : 'Teams and tasks the site covers well',
  audienceDescription:
    locale === 'he'
      ? 'האתר לא מיועד רק למפתחים. הוא מכסה גם עבודה על תוכן, שיווק, אופרציה וניתוח כשצריך תוצאה מהירה בלי לעבור לכלי כבד יותר.'
      : 'The site is not just for developers. It also covers content, marketing, operations and analysis when you need a fast result without jumping into a heavier tool.'
};
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  canonicalPath={`/${locale}/`}
  jsonLd={jsonLd}
  analyticsContext={{ pageType: 'home', locale }}
>
  <section class="hero-section">
    <div class="hero-copy">
      <p class="eyebrow">{labels.heroEyebrow}</p>
      <h1>{labels.heroTitle}</h1>
      <p>{labels.heroText}</p>
      <div class="hero-actions">
        <a class="primary-action" href="#tools">{labels.heroCta}</a>
        <span>{converters.length} {labels.tools}</span>
      </div>
    </div>
    <div class="hero-panel" aria-label={labels.privacy}>
      <div>
        <span>{labels.privacy}</span>
        <strong>100%</strong>
      </div>
      <div>
        <span>{labels.noUpload}</span>
        <strong>0</strong>
      </div>
      <div>
        <span>{labels.instant}</span>
        <strong>&lt;1s</strong>
      </div>
    </div>
  </section>

  <AdSlot locale={locale} placement="top" />

  <section class="section-shell" id="tools">
    <div class="section-heading">
      <p class="eyebrow">{labels.allTools}</p>
      <h2>{labels.search}</h2>
      <input class="tool-search" type="search" placeholder={labels.searchPlaceholder} data-tool-search aria-label={labels.search} />
    </div>
    <div class="category-tabs" aria-label={labels.categoriesTitle}>
      <button type="button" data-filter="all" class="active">{labels.allTools}</button>
      {categories.map((category) => <button type="button" data-filter={category}>{categoryLabels[category][locale]}</button>)}
    </div>
    <div class="tools-grid" data-home-tools-grid>
      {converters.map((tool) => <ToolCard tool={tool} locale={locale} />)}
    </div>
  </section>

  {homepageHighlights.popular.length > 0 && (
    <section class="section-shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{copy.popularEyebrow}</p>
          <h2>{copy.popularTitle}</h2>
        </div>
        <p class="section-note">{copy.popularDescription}</p>
      </div>
      <div class="tools-grid compact">
        {homepageHighlights.popular.map((tool) => <ToolCard tool={tool} locale={locale} />)}
      </div>
    </section>
  )}

  {homepageHighlights.fresh.length > 0 && (
    <section class="section-shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{copy.newEyebrow}</p>
          <h2>{copy.newTitle}</h2>
        </div>
        <p class="section-note">{copy.newDescription}</p>
      </div>
      <div class="tools-grid compact">
        {homepageHighlights.fresh.map((tool) => <ToolCard tool={tool} locale={locale} />)}
      </div>
    </section>
  )}

  <section class="content-grid">
    <article class="content-panel content-panel-wide">
      <p class="eyebrow">{copy.trustEyebrow}</p>
      <h2>{copy.trustTitle}</h2>
      <ul class="feature-list">
        {trustBlocks.map((block) => (
          <li>
            <strong>{block.title}</strong>
            <p>{block.description}</p>
          </li>
        ))}
      </ul>
    </article>
  </section>

  <section class="content-grid">
    <article class="content-panel content-panel-wide">
      <p class="eyebrow">{copy.audienceEyebrow}</p>
      <h2>{copy.audienceTitle}</h2>
      <p>{copy.audienceDescription}</p>
      <ul class="check-list">
        {audienceList.map((item) => <li>{item}</li>)}
      </ul>
    </article>
  </section>

  <section class="strategy-band">
    <div>
      <p class="eyebrow">{labels.strategyTitle}</p>
      <h2>{labels.strategyText}</h2>
    </div>
    <ul>
      {priorityHubs.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
  </section>

  <script>
    const search = document.querySelector<HTMLInputElement>('[data-tool-search]');
    const cards = [...document.querySelectorAll<HTMLElement>('[data-tool-card]')];
    const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    let activeFilter = 'all';
    let searchTimer: number | undefined;

    function trackHomeEvent(name: string, props: Record<string, string | number | boolean> = {}) {
      window.dispatchEvent(new CustomEvent('online-converter:event', { detail: { name, props } }));
    }

    function applyFilters() {
      const query = search?.value.trim().toLowerCase() ?? '';
      cards.forEach((card) => {
        const matchesText = !query || card.dataset.title?.includes(query);
        const matchesCategory = activeFilter === 'all' || card.dataset.category === activeFilter;
        card.hidden = !(matchesText && matchesCategory);
      });
    }

    search?.addEventListener('input', () => {
      applyFilters();
      window.clearTimeout(searchTimer);
      searchTimer = window.setTimeout(() => {
        const queryLength = search.value.trim().length;
        if (queryLength > 1) {
          trackHomeEvent('search_tools', {
            queryLength,
            visibleTools: cards.filter((card) => !card.hidden).length
          });
        }
      }, 500);
    });
    filters.forEach((filter) => {
      filter.addEventListener('click', () => {
        activeFilter = filter.dataset.filter ?? 'all';
        filters.forEach((item) => item.classList.toggle('active', item === filter));
        applyFilters();
        trackHomeEvent('filter_tools', {
          category: activeFilter,
          visibleTools: cards.filter((card) => !card.hidden).length
        });
      });
    });
  </script>
</BaseLayout>
