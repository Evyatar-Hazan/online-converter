---
import { ConverterWidget } from '../../components/ConverterWidget';
import AdSlot from '../../components/AdSlot.astro';
import ToolCard from '../../components/ToolCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { converterBySlug, converters } from '../../data/converters';
import { locales, ui } from '../../data/site';
import { getRelatedConverters } from '../../lib/related-tools';
import { formatContentType, getConverterIntro, getConverterMetaDescription, getConverterPageTitle, getConverterStructuredData } from '../../lib/converter-seo';
import type { ConverterTool, Locale } from '../../types';

function exampleOutputNote(tool: ConverterTool, locale: Locale) {
  return locale === 'he'
    ? `טען אחת מהדוגמאות כדי להתחיל מהר, להתאים את הערכים לצורך שלך ולראות איך ${tool.shortTitle.he} מגיב לקלט אמיתי.`
    : `Load one of the examples to start faster, adapt the values to your case, and see how ${tool.shortTitle.en} behaves with realistic input.`;
}

function examplesHeading(tool: ConverterTool, locale: Locale) {
  return locale === 'he'
    ? `דוגמאות שימוש ל־${tool.shortTitle.he}`
    : `Examples for ${tool.shortTitle.en}`;
}

function exampleHelperText(locale: Locale) {
  return locale === 'he'
    ? `כל כפתור דוגמה בתוך הכלי יטען את הקלט המתאים, כך שאפשר להתחיל בלי לנחש את הפורמט.`
    : `Each example button inside the tool loads the matching input so you can start without guessing the format.`;
}

function generatedFaq(tool: ConverterTool) {
  const input = formatContentType(tool.inputType);
  const output = formatContentType(tool.outputType);
  return [
    {
      question: {
        en: `What input does ${tool.shortTitle.en} expect?`,
        he: `איזה קלט מתאים ל־${tool.shortTitle.he}?`
      },
      answer: {
        en: `${tool.shortTitle.en} expects ${input} input and returns ${output} output. Start with the sample if you are unsure about the expected structure.`,
        he: `${tool.shortTitle.he} מקבל קלט מסוג ${input} ומחזיר פלט מסוג ${output}. אם לא בטוחים לגבי המבנה, כדאי להתחיל מהדוגמה המובנית.`
      }
    },
    {
      question: {
        en: `Why did ${tool.shortTitle.en} show an error?`,
        he: `למה ${tool.shortTitle.he} מציג שגיאה?`
      },
      answer: {
        en: `Errors usually mean the input is empty, incomplete or not valid ${input}. Check brackets, quotes, separators and special characters before converting again.`,
        he: `שגיאות בדרך כלל אומרות שהקלט ריק, חסר או לא תקין עבור ${input}. בדוק סוגריים, מרכאות, מפרידים ותווים מיוחדים לפני המרה נוספת.`
      }
    }
  ];
}

function conversionTips(tool: ConverterTool, locale: Locale) {
  const base = locale === 'he'
    ? ['נסה קודם את הדוגמה המובנית כדי להבין את מבנה הקלט.', 'בדוק שהקלט מלא לפני העתקה או הורדה של הפלט.', 'אם מתקבלת שגיאה, צמצם את הקלט לחלק קטן ובדוק אותו שוב.']
    : ['Try the built-in sample first to understand the expected input shape.', 'Check that the input is complete before copying or downloading the output.', 'If an error appears, reduce the input to a smaller section and test again.'];

  const categoryTip = {
    data: {
      en: 'For structured data, make sure nested objects, quotes and separators are valid before conversion.',
      he: 'בנתונים מובנים, ודא שאובייקטים מקוננים, מרכאות ומפרידים כתובים בצורה תקינה לפני ההמרה.'
    },
    text: {
      en: 'For text tools, watch for hidden spaces, empty lines and mixed line endings.',
      he: 'בכלי טקסט, שים לב לרווחים נסתרים, שורות ריקות וסיומות שורה מעורבות.'
    },
    encoding: {
      en: 'For encoding tools, keep the original text until you confirm the decoded or encoded result.',
      he: 'בכלי קידוד, שמור את הטקסט המקורי עד שאתה מוודא שהתוצאה המקודדת או המפוענחת נכונה.'
    },
    time: {
      en: 'For date tools, check whether the value is seconds, milliseconds, UTC or local time.',
      he: 'בכלי תאריך, בדוק אם הערך הוא שניות, מילישניות, UTC או זמן מקומי.'
    },
    developer: {
      en: 'For developer tools, validate the result before using it in production code or API requests.',
      he: 'בכלי פיתוח, אמת את התוצאה לפני שימוש בקוד production או בבקשות API.'
    },
    color: {
      en: 'For color tools, confirm that the final value matches the CSS or design system format you need.',
      he: 'בכלי צבעים, ודא שהערך הסופי מתאים לפורמט ה־CSS או מערכת העיצוב שאתה צריך.'
    },
    calculator: {
      en: 'For calculators, check the input order, units and decimal separators before relying on the result.',
      he: 'במחשבונים, בדוק את סדר הקלט, היחידות והמפרידים העשרוניים לפני הסתמכות על התוצאה.'
    }
  };

  return [categoryTip[tool.category][locale], ...base];
}

function commonIssues(tool: ConverterTool, locale: Locale) {
  const issues = {
    jsonToCsv: {
      en: ['JSON must be valid before it can become CSV.', 'Deeply nested objects may appear as JSON text inside a CSV cell.', 'CSV column order is based on discovered object keys.'],
      he: ['JSON חייב להיות תקין לפני שאפשר להפוך אותו ל־CSV.', 'אובייקטים מקוננים עמוק עשויים להופיע כטקסט JSON בתוך תא CSV.', 'סדר עמודות CSV מבוסס על המפתחות שנמצאו באובייקטים.']
    },
    csvToJson: {
      en: ['The first CSV row must contain headers.', 'Unmatched quotes can break CSV parsing.', 'Rows with missing cells get empty values.'],
      he: ['השורה הראשונה ב־CSV חייבת להכיל כותרות.', 'מרכאות לא סגורות עלולות לשבור את פענוח ה־CSV.', 'שורות עם תאים חסרים יקבלו ערכים ריקים.']
    },
    jwtDecoder: {
      en: ['JWT decoding is not signature verification.', 'Malformed Base64 sections will fail.', 'Never paste sensitive production tokens into shared screens.'],
      he: ['פענוח JWT אינו אימות חתימה.', 'מקטעי Base64 לא תקינים ייכשלו.', 'אל תדביק טוקנים רגישים ממערכות production במסכים משותפים.']
    }
  };

  if (tool.converterId in issues) {
    return issues[tool.converterId as keyof typeof issues][locale];
  }

  const defaults = {
    data: {
      en: ['Invalid structure is the most common cause of conversion errors.', 'Copying from rich text editors can add hidden characters.', 'Large inputs are easier to debug in smaller chunks.'],
      he: ['מבנה לא תקין הוא הגורם הנפוץ ביותר לשגיאות המרה.', 'העתקה מעורכי טקסט עשירים יכולה להוסיף תווים נסתרים.', 'קלט גדול קל יותר לדיבוג כשמחלקים אותו לחלקים קטנים.']
    },
    text: {
      en: ['Extra spaces can change the final text result.', 'Empty lines may be preserved depending on the tool.', 'Mixed Hebrew and English text can affect visual direction, not the actual text.'],
      he: ['רווחים עודפים יכולים לשנות את התוצאה הסופית.', 'שורות ריקות עשויות להישמר בהתאם לכלי.', 'טקסט עברי ואנגלי מעורב יכול להשפיע על התצוגה, לא בהכרח על הטקסט עצמו.']
    },
    encoding: {
      en: ['Partial encoded strings may fail to decode.', 'Special characters should be tested with a small sample first.', 'Double encoding can produce unexpected output.'],
      he: ['מחרוזות מקודדות חלקית עלולות להיכשל בפענוח.', 'כדאי לבדוק תווים מיוחדים עם דוגמה קטנה קודם.', 'קידוד כפול יכול לייצר פלט לא צפוי.']
    },
    time: {
      en: ['Seconds and milliseconds can produce very different dates.', 'Timezone display may differ between UTC and local output.', 'Invalid date strings cannot be converted reliably.'],
      he: ['שניות ומילישניות יכולות להחזיר תאריכים שונים מאוד.', 'תצוגת אזור זמן יכולה להשתנות בין UTC לפלט מקומי.', 'מחרוזות תאריך לא תקינות לא ניתנות להמרה אמינה.']
    },
    developer: {
      en: ['Syntax errors usually come from missing brackets, quotes or separators.', 'Formatted output should still be validated before use.', 'Sensitive code or tokens should not be shared in screenshots.'],
      he: ['שגיאות תחביר נובעות לרוב מסוגריים, מרכאות או מפרידים חסרים.', 'גם פלט מעוצב כדאי לאמת לפני שימוש.', 'קוד רגיש או טוקנים לא כדאי לשתף בצילומי מסך.']
    },
    color: {
      en: ['Color values outside the valid range cannot convert cleanly.', 'Short HEX and full HEX are both common but must be valid.', 'Copied RGB values should include three numeric channels.'],
      he: ['ערכי צבע מחוץ לטווח התקין לא יומרו בצורה נקייה.', 'HEX קצר ו־HEX מלא נפוצים, אבל חייבים להיות תקינים.', 'ערכי RGB מועתקים צריכים לכלול שלושה ערוצים מספריים.']
    },
    calculator: {
      en: ['Missing numbers are the most common cause of calculator errors.', 'Percent inputs should usually be written as 17 for 17%.', 'Large or important decisions should be checked with a trusted source.'],
      he: ['מספרים חסרים הם הגורם הנפוץ ביותר לשגיאות במחשבונים.', 'קלט אחוזים בדרך כלל צריך להיכתב כ־17 עבור 17%.', 'החלטות גדולות או חשובות כדאי לבדוק מול מקור אמין נוסף.']
    }
  };

  return defaults[tool.category][locale];
}

export function getStaticPaths() {
  return locales.flatMap((lang) => converters.map((tool) => ({ params: { lang, slug: tool.slug } })));
}

const locale = Astro.params.lang as Locale;
const slug = Astro.params.slug as string;
const tool = converterBySlug.get(slug);

if (!tool) {
  throw new Error(`Unknown converter slug: ${slug}`);
}

const labels = ui[locale];
const related = getRelatedConverters(tool, 3);
const contextualFaq = [...generatedFaq(tool), ...tool.faq];
const tips = conversionTips(tool, locale);
const issues = commonIssues(tool, locale);
const title = getConverterPageTitle(tool, locale);
const description = getConverterMetaDescription(tool, locale);
const canonicalPath = `/${locale}/${tool.slug}/`;
const jsonLd = getConverterStructuredData(tool, locale, description, contextualFaq, labels.home);
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  alternateSlug={tool.slug}
  jsonLd={jsonLd}
  analyticsContext={{ pageType: 'tool', locale, category: tool.category, tool: tool.slug, converter: tool.converterId }}
>
  <nav class="breadcrumbs" aria-label="Breadcrumbs">
    <a href={`/${locale}/`}>{labels.home}</a>
    <span>/</span>
    <span>{tool.shortTitle[locale]}</span>
  </nav>

  <section class="tool-hero">
    <div>
      <p class="eyebrow">{tool.keywords[locale][0]}</p>
      <h1>{tool.title[locale]}</h1>
      <p>{tool.description[locale]}</p>
      <div class="trust-row">
        <span>{labels.privacy}</span>
        <span>{labels.noUpload}</span>
        <span>{labels.instant}</span>
      </div>
    </div>
    <AdSlot locale={locale} placement="sidebar" />
  </section>

  <AdSlot locale={locale} placement="top" />

  <ConverterWidget client:load tool={tool} locale={locale} />

  <section class="content-grid">
    <article class="content-panel content-panel-wide">
      <p class="eyebrow">{locale === 'he' ? 'שימוש מעשי' : 'Practical use'}</p>
      <h2>{locale === 'he' ? `מתי להשתמש ב־${tool.shortTitle[locale]}` : `When to use ${tool.shortTitle[locale]}`}</h2>
      <p>{getConverterIntro(tool, locale)}</p>
      <ul class="check-list">
        {tool.features[locale].map((feature) => <li>{feature}</li>)}
      </ul>
    </article>
  </section>

  {tool.examples.length > 0 && (
    <section class="content-panel examples-panel">
      <div class="examples-header">
        <div>
          <p class="eyebrow">{locale === 'he' ? 'דוגמאות התחלה' : 'Starter examples'}</p>
          <h2>{examplesHeading(tool, locale)}</h2>
        </div>
        <p>{exampleOutputNote(tool, locale)}</p>
      </div>
      <p class="examples-helper">{exampleHelperText(locale)}</p>
      <div class="examples-grid">
        {tool.examples.slice(0, 3).map((example) => (
          <article class="example-card">
            <h3>{example.label[locale]}</h3>
            <pre><code>{example.input}</code></pre>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="content-grid">
    <article class="content-panel">
      <p class="eyebrow">{labels.guideTitle}</p>
      <h2>{labels.guideTitle}</h2>
      <ol>
        {tool.guide[locale].map((step) => <li>{step}</li>)}
      </ol>
    </article>
    <article class="content-panel">
      <p class="eyebrow">{labels.faqTitle}</p>
      <h2>{labels.faqTitle}</h2>
      {contextualFaq.map((item) => (
        <details>
          <summary>{item.question[locale]}</summary>
          <p>{item.answer[locale]}</p>
        </details>
      ))}
    </article>
  </section>

  <section class="content-grid">
    <article class="content-panel">
      <p class="eyebrow">{locale === 'he' ? 'טיפים לפני המרה' : 'Before converting'}</p>
      <h2>{locale === 'he' ? 'איך לקבל תוצאה נקייה יותר' : 'How to get a cleaner result'}</h2>
      <ul class="check-list">
        {tips.map((tip) => <li>{tip}</li>)}
      </ul>
    </article>
    <article class="content-panel">
      <p class="eyebrow">{locale === 'he' ? 'בעיות נפוצות' : 'Common issues'}</p>
      <h2>{locale === 'he' ? 'מה לבדוק אם משהו לא עובד' : 'What to check if something fails'}</h2>
      <ul class="issue-list">
        {issues.map((issue) => <li>{issue}</li>)}
      </ul>
    </article>
  </section>

  <AdSlot locale={locale} placement="inline" />

  <section class="section-shell">
    <div class="section-heading">
      <p class="eyebrow">{labels.relatedTitle}</p>
      <h2>{labels.relatedTitle}</h2>
    </div>
    <div class="tools-grid compact">
      {related.map((item) => item && <ToolCard tool={item} locale={locale} />)}
    </div>
  </section>

  <AdSlot locale={locale} placement="bottom" />
</BaseLayout>
