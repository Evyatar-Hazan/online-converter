---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  analyticsCategoryRows,
  analyticsEvents,
  analyticsProviders,
  analyticsSummary,
  englishLongTailSummary,
  hebrewOpportunitySummary,
  indexingChecklistSteps,
  indexingChecklistSummary,
  keywordIntentSummary,
  keywordMapSummary,
  priorityEnglishLongTailRows,
  priorityHebrewOpportunityRows,
  priorityIntentRows,
  priorityKeywordRows,
  priorityRankingRows,
  rankingMonitorSummary,
  rankingWorkflowSteps,
  searchConsoleBaseline
} from '../data/analytics-dashboard';
import { siteName } from '../data/site';

const title = `Analytics Dashboard | ${siteName.en}`;
const description = 'Internal analytics readiness dashboard for Online Converter traffic, tool usage, SEO coverage and ad visibility instrumentation.';
const readyProviders = analyticsProviders.filter((provider) => provider.status === 'ready').length;
---

<BaseLayout
  locale="en"
  title={title}
  description={description}
  canonicalPath="/analytics/"
  indexable={false}
  includeAlternates={false}
  analyticsContext={{ pageType: 'dashboard', locale: 'en' }}
>
  <section class="analytics-hero">
    <div>
      <p class="eyebrow">Internal dashboard</p>
      <h1>Analytics readiness</h1>
      <p>
        Operational view for tracking SEO coverage, converter usage, ad-slot visibility and provider readiness without exposing personal data or raw user input.
      </p>
    </div>
    <div class="analytics-status-panel" aria-label="Analytics status">
      <span>Providers ready</span>
      <strong>{readyProviders}/{analyticsProviders.length}</strong>
      <small>{analyticsSummary.trackedEvents} tracked events mapped</small>
    </div>
  </section>

  <section class="analytics-kpi-grid" aria-label="Analytics KPIs">
    <article>
      <span>Public SEO pages</span>
      <strong>{analyticsSummary.publicSeoPages}</strong>
      <small>Home, category and converter pages</small>
    </article>
    <article>
      <span>Localized tool pages</span>
      <strong>{analyticsSummary.localizedToolPages}</strong>
      <small>Hebrew and English converter URLs</small>
    </article>
    <article>
      <span>Converters</span>
      <strong>{analyticsSummary.totalConverters}</strong>
      <small>{analyticsSummary.categories} categories</small>
    </article>
    <article>
      <span>Ad placements</span>
      <strong>{analyticsSummary.adPlacements}</strong>
      <small>Top, inline, sidebar and bottom</small>
    </article>
  </section>

  <section class="analytics-grid">
    <article class="analytics-panel">
      <div class="analytics-panel-heading">
        <p class="eyebrow">Provider status</p>
        <h2>Data sources</h2>
      </div>
      <div class="analytics-provider-list">
        {analyticsProviders.map((provider) => (
          <div class="analytics-provider-row">
            <div>
              <strong>{provider.name}</strong>
              <span>{provider.role}</span>
            </div>
            <code>{provider.env}</code>
            <mark data-status={provider.status}>{provider.status}</mark>
          </div>
        ))}
      </div>
    </article>

    <article class="analytics-panel">
      <div class="analytics-panel-heading">
        <p class="eyebrow">Event map</p>
        <h2>Tracked product signals</h2>
      </div>
      <div class="analytics-event-list">
        {analyticsEvents.map((event) => (
          <div class="analytics-event-row">
            <code>{event.name}</code>
            <span>{event.purpose}</span>
            <small>{event.owner} · {event.priority}</small>
          </div>
        ))}
      </div>
    </article>
  </section>

  <section class="analytics-panel analytics-panel-wide">
    <div class="analytics-panel-heading analytics-heading-split">
      <div>
        <p class="eyebrow">Search Console</p>
        <h2>Ranking baseline</h2>
      </div>
      <span class="analytics-date">Verified {searchConsoleBaseline.verifiedAt}</span>
    </div>
    <div class="ranking-baseline-grid" aria-label="Search Console ranking baseline">
      <article>
        <span>Clicks</span>
        <strong>{searchConsoleBaseline.clicks}</strong>
      </article>
      <article>
        <span>Impressions</span>
        <strong>{searchConsoleBaseline.impressions}</strong>
      </article>
      <article>
        <span>CTR</span>
        <strong>{searchConsoleBaseline.ctr}</strong>
      </article>
      <article>
        <span>Avg. position</span>
        <strong>{searchConsoleBaseline.averagePosition}</strong>
      </article>
    </div>
    <p class="analytics-note">
      {searchConsoleBaseline.note} Visible page: <code>{searchConsoleBaseline.onlyVisiblePage}</code>.
    </p>
  </section>

  <section class="analytics-panel analytics-panel-wide">
    <div class="analytics-panel-heading">
      <p class="eyebrow">SEO inventory</p>
      <h2>Coverage by category</h2>
    </div>
    <div class="analytics-table-wrap">
      <table class="analytics-table">
        <thead>
          <tr>
            <th>Category</th>
            <th>Tools</th>
            <th>Localized pages</th>
            <th>Popular</th>
            <th>New</th>
          </tr>
        </thead>
        <tbody>
          {analyticsCategoryRows.map((row) => (
            <tr>
              <td>{row.label}</td>
              <td>{row.tools}</td>
              <td>{row.localizedPages}</td>
              <td>{row.popular}</td>
              <td>{row.newTools}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="analytics-grid">
    <article class="analytics-panel">
      <div class="analytics-panel-heading">
        <p class="eyebrow">Ranking workflow</p>
        <h2>Weekly loop</h2>
      </div>
      <div class="analytics-event-list">
        {rankingWorkflowSteps.map((item) => (
          <div class="analytics-event-row">
            <code>{item.step}</code>
            <span>{item.description}</span>
            <small>SEO · P1</small>
          </div>
        ))}
      </div>
    </article>

    <article class="analytics-panel">
      <div class="analytics-panel-heading">
        <p class="eyebrow">Ranking monitor</p>
        <h2>Tracked converter pages</h2>
      </div>
      <div class="ranking-summary-list">
        <div>
          <span>Converters</span>
          <strong>{rankingMonitorSummary.trackedConverters}</strong>
        </div>
        <div>
          <span>Localized pages</span>
          <strong>{rankingMonitorSummary.trackedLocalizedPages}</strong>
        </div>
        <div>
          <span>P1 converters</span>
          <strong>{rankingMonitorSummary.p1Converters}</strong>
        </div>
        <div>
          <span>Rows with GSC data</span>
          <strong>{rankingMonitorSummary.rowsWithSearchConsoleData}</strong>
        </div>
      </div>
    </article>
  </section>

  <section class="analytics-panel analytics-panel-wide">
    <div class="analytics-panel-heading analytics-heading-split">
      <div>
        <p class="eyebrow">Indexing operations</p>
        <h2>Weekly indexing checklist</h2>
      </div>
      <span class="analytics-date">{indexingChecklistSummary.cadence} review</span>
    </div>
    <div class="ranking-summary-list">
      <div>
        <span>Sitemap URLs</span>
        <strong>{indexingChecklistSummary.sitemapUrls}</strong>
      </div>
      <div>
        <span>Priority queue</span>
        <strong>{indexingChecklistSummary.priorityQueue}</strong>
      </div>
      <div>
        <span>Google block</span>
        <strong>{indexingChecklistSummary.blockedByGoogle ? 'Yes' : 'No'}</strong>
      </div>
      <div>
        <span>Automation</span>
        <strong>SEO gate</strong>
      </div>
    </div>
    <div class="analytics-event-list">
      {indexingChecklistSteps.map((item) => (
        <div class="analytics-event-row analytics-checklist-row">
          <code>{item.step}</code>
          <span>{item.detail}</span>
          <small>{item.owner} · {item.status}</small>
        </div>
      ))}
    </div>
  </section>

  <section class="analytics-panel analytics-panel-wide">
    <div class="analytics-panel-heading analytics-heading-split">
      <div>
        <p class="eyebrow">Keyword strategy</p>
        <h2>Bilingual keyword map</h2>
      </div>
      <span class="analytics-date">Registry coverage</span>
    </div>
    <div class="ranking-summary-list">
      <div>
        <span>Converters mapped</span>
        <strong>{keywordMapSummary.trackedConverters}</strong>
      </div>
      <div>
        <span>EN primary</span>
        <strong>{keywordMapSummary.mappedEnglishPrimary}</strong>
      </div>
      <div>
        <span>HE primary</span>
        <strong>{keywordMapSummary.mappedHebrewPrimary}</strong>
      </div>
      <div>
        <span>Secondary coverage</span>
        <strong>{keywordMapSummary.mappedEnglishSecondary}/{keywordMapSummary.mappedHebrewSecondary}</strong>
      </div>
    </div>
    <div class="analytics-table-wrap">
      <table class="analytics-table keyword-map-table">
        <thead>
          <tr>
            <th>Tool</th>
            <th>Category</th>
            <th>Primary EN</th>
            <th>Secondary EN</th>
            <th>Primary HE</th>
            <th>Secondary HE</th>
          </tr>
        </thead>
        <tbody>
          {priorityKeywordRows.map((row) => (
            <tr>
              <td>
                <a href={row.englishUrl}>{row.slug}</a>
                <small>{row.hebrewUrl}</small>
              </td>
              <td>{row.categoryLabel}</td>
              <td>{row.primaryEnglishQuery}</td>
              <td>{row.secondaryEnglishQueries.join(' • ') || 'n/a'}</td>
              <td dir="rtl">{row.primaryHebrewQuery}</td>
              <td dir="rtl">{row.secondaryHebrewQueries.join(' • ') || 'n/a'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="analytics-panel analytics-panel-wide">
    <div class="analytics-panel-heading analytics-heading-split">
      <div>
        <p class="eyebrow">Intent map</p>
        <h2>Search intent coverage</h2>
      </div>
      <span class="analytics-date">Registry classification</span>
    </div>
    <div class="ranking-summary-list">
      {keywordIntentSummary.map((item) => (
        <div>
          <span>{item.intent}</span>
          <strong>{item.count}</strong>
        </div>
      ))}
    </div>
    <div class="analytics-table-wrap">
      <table class="analytics-table intent-map-table">
        <thead>
          <tr>
            <th>Tool</th>
            <th>Category</th>
            <th>Intent</th>
            <th>Primary EN</th>
            <th>Primary HE</th>
          </tr>
        </thead>
        <tbody>
          {priorityIntentRows.map((row) => (
            <tr>
              <td>
                <a href={row.englishUrl}>{row.slug}</a>
                <small>{row.hebrewUrl}</small>
              </td>
              <td>{row.categoryLabel}</td>
              <td><strong>{row.intent}</strong></td>
              <td>{row.primaryEnglishQuery}</td>
              <td dir="rtl">{row.primaryHebrewQuery}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="analytics-panel analytics-panel-wide">
    <div class="analytics-panel-heading analytics-heading-split">
      <div>
        <p class="eyebrow">Hebrew opportunity</p>
        <h2>Priority Hebrew opportunities</h2>
      </div>
      <span class="analytics-date">Heuristic scoring</span>
    </div>
    <div class="ranking-summary-list">
      <div>
        <span>Tracked</span>
        <strong>{hebrewOpportunitySummary.trackedConverters}</strong>
      </div>
      <div>
        <span>High</span>
        <strong>{hebrewOpportunitySummary.high}</strong>
      </div>
      <div>
        <span>Medium</span>
        <strong>{hebrewOpportunitySummary.medium}</strong>
      </div>
      <div>
        <span>Watch</span>
        <strong>{hebrewOpportunitySummary.watch}</strong>
      </div>
    </div>
    <div class="analytics-table-wrap">
      <table class="analytics-table opportunity-table">
        <thead>
          <tr>
            <th>Tool</th>
            <th>Intent</th>
            <th>Primary HE</th>
            <th>Score</th>
            <th>Band</th>
            <th>Why now</th>
          </tr>
        </thead>
        <tbody>
          {priorityHebrewOpportunityRows.map((row) => (
            <tr>
              <td>
                <a href={row.englishUrl}>{row.slug}</a>
                <small>{row.hebrewUrl}</small>
              </td>
              <td><strong>{row.intent}</strong></td>
              <td dir="rtl">{row.primaryHebrewQuery}</td>
              <td>{row.score}</td>
              <td>{row.band}</td>
              <td>{row.reasons.join(' • ')}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="analytics-panel analytics-panel-wide">
    <div class="analytics-panel-heading analytics-heading-split">
      <div>
        <p class="eyebrow">English long-tail</p>
        <h2>Priority English long-tail opportunities</h2>
      </div>
      <span class="analytics-date">Heuristic scoring</span>
    </div>
    <div class="ranking-summary-list">
      <div>
        <span>Tracked</span>
        <strong>{englishLongTailSummary.trackedConverters}</strong>
      </div>
      <div>
        <span>High</span>
        <strong>{englishLongTailSummary.high}</strong>
      </div>
      <div>
        <span>Medium</span>
        <strong>{englishLongTailSummary.medium}</strong>
      </div>
      <div>
        <span>Watch</span>
        <strong>{englishLongTailSummary.watch}</strong>
      </div>
    </div>
    <div class="analytics-table-wrap">
      <table class="analytics-table opportunity-table">
        <thead>
          <tr>
            <th>Tool</th>
            <th>Intent</th>
            <th>Primary EN</th>
            <th>Score</th>
            <th>Band</th>
            <th>Why now</th>
          </tr>
        </thead>
        <tbody>
          {priorityEnglishLongTailRows.map((row) => (
            <tr>
              <td>
                <a href={row.englishUrl}>{row.slug}</a>
                <small>{row.hebrewUrl}</small>
              </td>
              <td><strong>{row.intent}</strong></td>
              <td>{row.primaryEnglishQuery}</td>
              <td>{row.score}</td>
              <td>{row.band}</td>
              <td>{row.reasons.join(' • ')}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="analytics-panel analytics-panel-wide">
    <div class="analytics-panel-heading">
      <p class="eyebrow">Priority converters</p>
      <h2>First ranking watchlist</h2>
    </div>
    <div class="analytics-table-wrap">
      <table class="analytics-table ranking-table">
        <thead>
          <tr>
            <th>Tool</th>
            <th>Category</th>
            <th>English query</th>
            <th>Hebrew query</th>
            <th>Indexed</th>
            <th>Impr.</th>
            <th>Avg. pos.</th>
            <th>Next action</th>
          </tr>
        </thead>
        <tbody>
          {priorityRankingRows.map((row) => (
            <tr>
              <td>
                <a href={row.englishUrl}>{row.slug}</a>
                <small>{row.hebrewUrl}</small>
              </td>
              <td>{row.categoryLabel}</td>
              <td>{row.targetEnglishQuery}</td>
              <td dir="rtl">{row.targetHebrewQuery}</td>
              <td>{row.indexed}</td>
              <td>{row.impressions}</td>
              <td>{row.averagePosition}</td>
              <td>{row.nextAction}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>
