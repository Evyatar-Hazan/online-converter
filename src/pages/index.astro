---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteName } from '../data/site';

const title = 'Online Converter - Fast bilingual converter tools';
const description = 'Choose English or Hebrew and open fast browser-based converter tools for data, text, colors, calculators and developer work.';
---

<BaseLayout locale="en" title={title} description={description} canonicalPath="/en/" jsonLd={[]} analyticsContext={{ pageType: 'home', locale: 'en' }}>
  <section class="hero-section">
    <div class="hero-copy">
      <p class="eyebrow">Bilingual converter hub</p>
      <h1>{siteName.en}</h1>
      <p>{description}</p>
      <div class="hero-actions">
        <a class="primary-action" href="/en/">Open English tools</a>
        <a class="secondary-action" href="/he/">פתח כלים בעברית</a>
      </div>
    </div>
    <div class="hero-panel" aria-label="Language options">
      <div>
        <span>English</span>
        <strong>EN</strong>
      </div>
      <div>
        <span>עברית</span>
        <strong>HE</strong>
      </div>
      <div>
        <span>No uploads</span>
        <strong>0</strong>
      </div>
    </div>
  </section>
</BaseLayout>
