---
import { ui } from '../data/site';
import type { Locale } from '../types';

interface Props {
  locale: Locale;
  placement: 'top' | 'inline' | 'sidebar' | 'bottom';
}

const { locale, placement } = Astro.props;
const labels = ui[locale];
const adText = locale === 'he' ? 'שטח פרסום' : 'Ad space';
---

<aside class={`ad-slot ad-slot-${placement}`} aria-label={labels.adLabel}>
  <span>{labels.adLabel}</span>
  <div>{adText}</div>
</aside>
