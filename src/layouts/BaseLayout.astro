---
import ThemeScript from '../components/ThemeScript.astro';
import Analytics from '../components/Analytics.astro';
import AdSenseScript from '../components/AdSenseScript.astro';
import { locales, siteName, siteUrl, ui } from '../data/site';
import { getPriorityHubLinks } from '../lib/site-navigation';
import type { Locale } from '../types';
import '../styles/global.css';

interface AnalyticsContext {
  pageType: 'home' | 'category' | 'tool' | 'dashboard';
  locale: Locale;
  category?: string;
  tool?: string;
  converter?: string;
}

interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonicalPath: string;
  alternateSlug?: string;
  indexable?: boolean;
  includeAlternates?: boolean;
  jsonLd?: Record<string, unknown>[];
  analyticsContext?: AnalyticsContext;
}

const {
  locale,
  title,
  description,
  canonicalPath,
  alternateSlug = '',
  indexable = true,
  includeAlternates = true,
  jsonLd = [],
  analyticsContext
} = Astro.props;
const labels = ui[locale];
const footerHubLinks = getPriorityHubLinks(locale).slice(0, 4);
const otherLocale = locale === 'he' ? 'en' : 'he';
const alternatePath = alternateSlug ? `/${otherLocale}/${alternateSlug}/` : `/${otherLocale}/`;
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const pageContext = analyticsContext ?? { pageType: 'home', locale };
---

<!doctype html>
<html lang={locale} dir={labels.direction}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index, follow, max-image-preview:large' : 'noindex, nofollow'} />
    <link rel="canonical" href={canonicalUrl} />
    {includeAlternates && locales.map((lang) => <link rel="alternate" hreflang={lang} href={`${siteUrl}/${lang}/${alternateSlug ? `${alternateSlug}/` : ''}`} />)}
    {includeAlternates && <link rel="alternate" hreflang="x-default" href={`${siteUrl}/en/${alternateSlug ? `${alternateSlug}/` : ''}`} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName[locale]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ThemeScript />
    <Analytics context={pageContext} />
    <AdSenseScript />
    {jsonLd.map((schema) => <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">{labels.tools}</a>
    <header class="site-header">
      <nav class="nav-shell" aria-label="Main navigation">
        <a class="brand" href={`/${locale}/`} aria-label={siteName[locale]}>
          <span class="brand-mark">OC</span>
          <span>{siteName[locale]}</span>
        </a>
        <div class="nav-actions">
          <a href={alternatePath} class="nav-link">{labels.langLabel}</a>
          <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle theme">
            <span aria-hidden="true">◐</span>
          </button>
        </div>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-copy">
        <p>{labels.footer}</p>
        <p>
          {labels.credit}{' '}
          <a href="https://evyatarhazan.com/" target="_blank" rel="noopener noreferrer">Evyatar Hazan</a>
        </p>
      </div>
      <nav aria-label="Footer">
        <a href={`/${locale}/`}>{labels.home}</a>
        {footerHubLinks.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href="/sitemap.xml">{labels.sitemap}</a>
      </nav>
    </footer>
    <script is:inline>
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('oc-theme', next);
      });
    </script>
  </body>
</html>
